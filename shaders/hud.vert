#version 450

// Полноэкранный треугольник для HUD.
//
// Тот же приём, что в map.vert: вершинный буфер не используется, три вершины
// синтезируются из gl_VertexIndex, поэтому пайплайн создаётся вообще без
// vertex input и не конфликтует с форматом вершины сцены.
//
// Треугольник БОЛЬШЕ экрана (вершины -1..3), поэтому ни швов, ни диагонального
// артефакта от деления quad'а на два треугольника.
//
// Сам HUD занимает крошечный прямоугольник в левом верхнем углу, и растеризует
// его всю область вьюпорта не нужно: vkCmdSetScissor в command_buffers.cpp
// ограничивает растеризацию этим прямоугольником. Без scissor шейдер выполнялся
// бы на всех ~2 млн пикселей кадра ради сотни пикселей текста — на карте,
// которую мы только что разгрузили ограничением кадра, это лишнее.

layout(location = 0) out vec2 vUv;

void main() {
    // (0,0), (2,0), (0,2) в clip space -> перекрывают весь экран.
    vUv = vec2((gl_VertexIndex << 1) & 2, gl_VertexIndex & 2);
    gl_Position = vec4(vUv * 2.0 - 1.0, 0.0, 1.0);
}
