#version 450

// Полноэкранный треугольник для карты мира.
//
// Вершинный буфер НЕ используется: три вершины синтезируются из
// gl_VertexIndex. Это заодно снимает конфликт с основным пайплайном сцены —
// у него свой формат вершины (position + normal + UV + color + snowBias,
// шаг 52 байта) и матрица инстанса в locations 6..9, и трогать его ради
// карты не нужно. Здесь пайплайн создаётся вообще без vertex input.
//
// Треугольник БОЛЬШЕ экрана (вершины -1..3), поэтому ни швов, ни
// диагонального артефакта от деления quad'а на два треугольника.

layout(location = 0) out vec2 vUv;

void main() {
    // (0,0), (2,0), (0,2) в clip space -> перекрывают весь экран.
    vUv = vec2((gl_VertexIndex << 1) & 2, gl_VertexIndex & 2);
    gl_Position = vec4(vUv * 2.0 - 1.0, 0.0, 1.0);
}
